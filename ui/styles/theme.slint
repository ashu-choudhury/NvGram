export global AppTheme {
    // Colors
    out property <color> background: #12171E;
    out property <color> surface: #1A222D;
    out property <color> surface_variant: #242E3D;
    out property <color> primary: #2AABEE; // Telegram blue
    out property <color> primary_hover: #40B7F4;
    out property <color> primary_pressed: #1E96D4;
    out property <color> text_primary: #FFFFFF;
    out property <color> text_secondary: #9AA6B2;
    out property <color> border: #2F3B4D;
    out property <color> focus_ring: #52B5FF;
    out property <color> error: #E53935;
    out property <color> success: #43A047;
    out property <color> bubble_out: #2B5278;
    out property <color> bubble_in: #182533;

    // Sizing & Spacing
    out property <length> space_xs: 4px;
    out property <length> space_sm: 8px;
    out property <length> space_md: 12px;
    out property <length> space_lg: 16px;
    out property <length> space_xl: 24px;
    out property <length> radius_sm: 4px;
    out property <length> radius_md: 8px;
    out property <length> radius_lg: 12px;

    // Typography
    out property <length> font_size_sm: 12px;
    out property <length> font_size_base: 14px;
    out property <length> font_size_lg: 16px;
    out property <length> font_size_xl: 20px;
    out property <length> font_size_2xl: 24px;
}

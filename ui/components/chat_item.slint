import { AppTheme } from "../styles/theme.slint";

export component ChatItem inherits Rectangle {
    in property <string> chat_title: "Telegram User";
    in property <string> last_message: "";
    in property <string> time_text: "";
    in property <int> unread_count: 0;
    in property <bool> is_selected: false;
    in property <bool> is_active: false;

    callback clicked();

    height: 64px;
    border-radius: AppTheme.radius_md;
    background: root.is_selected ? AppTheme.surface_variant :
                (root.is_active ? #243042 :
                (touch_area.has-hover ? #1E2734 : Colors.transparent));
    border-width: root.is_active ? 2px : 0px;
    border-color: AppTheme.focus_ring;

    accessible-role: list-item;
    accessible-label: root.chat_title + 
                     (root.unread_count > 0 ? (", " + root.unread_count + " unread") : "") + 
                     (root.last_message != "" ? (". Last message: " + root.last_message) : "") + 
                     (root.time_text != "" ? (", " + root.time_text) : "");

    touch_area := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: AppTheme.space_md;
        padding-right: AppTheme.space_md;
        spacing: AppTheme.space_md;
        alignment: space-between;

        // Avatar icon circle
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: root.is_selected ? AppTheme.primary : #2C3E50;
            y: (parent.height - self.height) / 2;

            Text {
                text: "💬";
                font-size: AppTheme.font_size_lg;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Title and snippet
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;

            HorizontalLayout {
                Text {
                    text: root.chat_title;
                    color: AppTheme.text_primary;
                    font-size: AppTheme.font_size_base;
                    font-weight: 600;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if (root.time_text != "") : Text {
                    text: root.time_text;
                    color: AppTheme.text_secondary;
                    font-size: AppTheme.font_size_sm;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                Text {
                    text: root.last_message != "" ? root.last_message : "No messages yet";
                    color: AppTheme.text_secondary;
                    font-size: AppTheme.font_size_sm;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                // Unread counter badge
                if (root.unread_count > 0) : Rectangle {
                    min-width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: AppTheme.primary;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text {
                            text: root.unread_count;
                            color: Colors.white;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
